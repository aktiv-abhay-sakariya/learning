<odoo>
    <!-- List View: Displays a table of library books (name, isbn, price, pages) -->
    <record id='book_view_list' model='ir.ui.view'>
        <field name="name">library.book.view.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name='name'/>
                <field name='isbn'/>
                <field name='price'/>
                <field name='pages'/>
            </list>
        </field>
    </record>

    <!-- Form View: Detailed view for editing/creating a book-->
    <record id='book_view_form' model='ir.ui.view'>
        <field name="name">library.book.view.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Idea form">
                <group>
                    <group>
                        <field name='name'/>
                        <field name='isbn'/>
                        <field name='publication_date'/>
                        <field name='pages'/>
                        <field name='edition_ids' widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name='price'/>
                            <field name='category_id'/>
                        </group>
                        <group>
                            <field name='image_1920' nolabel="1" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                </group>
                <notebook>
                    <page string="Description">
                        <field name="description" widget="html"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <!-- Search View: Enables filtering and searching on books (name, isbn) -->
    <record id='book_view_search' model='ir.ui.view'>
        <field name="name">library.book.view.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name='name'/>
                <field name='isbn'/>
            </search>
        </field>
    </record>

    <!-- Action: Defines how to open the books records -->
    <record model="ir.actions.act_window" id="menu_access_book">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form,search</field>
        <field name="help">Add books</field>
    </record>

    <menuitem id="main_menu_access" name="Library Management"/>
    <menuitem id="menu_access" name="Library Management" parent="main_menu_access"/>
    <menuitem id="sub_menu_access_book" name="Books" parent="menu_access" action="menu_access_book"/>
</odoo>
